{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flappy Crix",
  "version": "3.0.0",
  "identifier": "com.crixgamingvr.flappycrix",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src https://crixgamingvr.com https://api.github.com",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CRIX STUDIOS",
    "copyright": "© CRIX STUDIOS",
    "category": "Game",
    "shortDescription": "Flappy Crix",
    "longDescription": "Flappy Crix by CRIX STUDIOS. Inspired by Flappy Bird by Dong Nguyen.",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
