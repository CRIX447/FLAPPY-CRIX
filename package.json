{
  "name": "flappy-crix",
  "version": "1.2.0",
  "description": "Flappy Crix — CRIX STUDIOS",
  "main": "main.js",
  "author": {
    "name": "CRIX STUDIOS",
    "email": "cgvr@crixgamingvr.com"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "publish": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.crixgamingvr.flappycrix",
    "productName": "Flappy Crix",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "icon.ico",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false,
      "loadBrowserProcessSpecificV8Snapshot": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flappy Crix",
      "artifactName": "FlappyCrixSetup-${version}.exe",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "portable": {
      "artifactName": "FlappyCrix.exe"
    },
    "copyright": "© CRIX STUDIOS",
    "publish": [
      {
        "provider": "github",
        "owner": "CRIX447",
        "repo": "FLAPPY-CRIX",
        "releaseType": "draft"
      }
    ],
    "afterPack": "build/afterPack.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
